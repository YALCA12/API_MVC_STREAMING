
### Obtener todos los usuarios
GET http://localhost:3000/api/usuarios


### Registrar un usuario nuevo
POST http://localhost:3000/api/usuarios
Content-Type: application/json

{
    "Nombre": "Usuario Prueba API",
    "Email": "prueba.api2026_nuevo@email.com",
    "Pais": "Peru",
    "FechaRegistro": "2026-11-22",
    "Estado": "Activo"
}



### Actualizar usuario
PUT http://localhost:3000/api/usuarios/16
Content-Type: application/json

{
    "Nombre": "Usuario Prueba Actualizado",
    "Email": "prueba.actualizada@email.com",
    "Pais": "Peru",
    "FechaRegistro": "2026-11-22",
    "Estado": "Activo"
}



### Eliminar usuario de prueba
DELETE http://localhost:3000/api/usuarios/16



### Verificar que el usuario fue eliminado
GET http://localhost:3000/api/usuarios/16



### Registrar un plan nuevo
POST http://localhost:3000/api/planes
Content-Type: application/json

{
    "NombrePlan": "Plan Prueba API",
    "Precio": 15,
    "CantidadPantallas": 1
}



### Actualizar plan
PUT http://localhost:3000/api/planes/7
Content-Type: application/json

{
    "NombrePlan": "Plan Prueba Actualizado",
    "Precio": 25,
    "CantidadPantallas": 2
}



### Eliminar plan de prueba
DELETE http://localhost:3000/api/planes/7

### Verificar eliminacion del plan
GET http://localhost:3000/api/planes/7



### Listar todos los contenidos
GET http://localhost:3000/api/contenidos

### Registrar contenido nuevo
POST http://localhost:3000/api/contenidos
Content-Type: application/json

{
    "Titulo": "Contenido Prueba API",
    "Tipo": "Pelicula",
    "Categoria": "Accion",
    "Anio": 2026,
    "DuracionMin": 90,
    "Disponible": true
}



### Actualizar contenido
PUT http://localhost:3000/api/contenidos/12
Content-Type: application/json

{
    "Titulo": "Contenido Prueba Actualizado",
    "Tipo": "Serie",
    "Categoria": "Drama",
    "Anio": 2025,
    "DuracionMin": 120,
    "Disponible": true
}



### Eliminar contenido de prueba
DELETE http://localhost:3000/api/contenidos/12


### Verificar eliminacion de contenido
GET http://localhost:3000/api/contenidos/12


### Listar todas las suscripciones
GET http://localhost:3000/api/suscripciones

### Registrar suscripcion nueva
POST http://localhost:3000/api/suscripciones
Content-Type: application/json

{
    "UsuarioID": 1,
    "PlanID": 1,
    "FechaInicio": "2026-11-22",
    "FechaFin": null,
    "Activo": true
}



### Actualizar suscripcion
PUT http://localhost:3000/api/suscripciones/13
Content-Type: application/json

{
    "UsuarioID": 1,
    "PlanID": 2,
    "FechaInicio": "2026-11-22",
    "FechaFin": null,
    "Activo": false
}


### Eliminar suscripcion
DELETE http://localhost:3000/api/suscripciones/13


### Verificar eliminacion de suscripcion
GET http://localhost:3000/api/suscripciones/13




### Listar todas las reproducciones
GET http://localhost:3000/api/reproducciones

### Registrar reproduccion nueva
POST http://localhost:3000/api/reproducciones
Content-Type: application/json

{
    "UsuarioID": 1,
    "ContenidoID": 1,
    "FechaReproduccion": "2026-11-22",
    "MinutosVistos": 30
}



### Actualizar reproduccion
PUT http://localhost:3000/api/reproducciones/14
Content-Type: application/json

{
    "UsuarioID": 1,
    "ContenidoID": 2,
    "FechaReproduccion": "2026-11-22",
    "MinutosVistos": 60
}



### Eliminar reproduccion de prueba
DELETE http://localhost:3000/api/reproducciones/14


### Verificar eliminacion de reproduccion
GET http://localhost:3000/api/reproducciones/14




### Listar todos los pagos
GET http://localhost:3000/api/pagos

### Registrar pago nuevo
POST http://localhost:3000/api/pagos
Content-Type: application/json

{
    "SuscripcionID": 1,
    "FechaPago": "2026-11-22",
    "Monto": 25,
    "MetodoPago": "Tarjeta",
    "EstadoPago": "Pagado"
}



### Actualizar pago
PUT http://localhost:3000/api/pagos/9
Content-Type: application/json

{
    "SuscripcionID": 1,
    "FechaPago": "2026-11-22",
    "Monto": 35,
    "MetodoPago": "Transferencia",
    "EstadoPago": "Pagado"
}


### Eliminar pago de prueba
DELETE http://localhost:3000/api/pagos/9


### Verificar eliminacion de pago
GET http://localhost:3000/api/pagos/9





